[Unit]
Description=Pull, build and deploy %i from GitHub (auto-rollback on failure)
Documentation=https://github.com/mkotik/personal-mcp/blob/main/docs/CONVENTIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/auto-deploy %i
TimeoutStartSec=20min
PrivateTmp=true
Nice=10
