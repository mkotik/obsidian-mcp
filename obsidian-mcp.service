[Unit]
Description=Obsidian vault MCP server (loopback only, Cloudflare Access authenticated)
Documentation=https://ts.sdk.modelcontextprotocol.io/v2/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/obsidian-mcp
Environment=NODE_ENV=production
Environment=VAULT_ROOT=/home/ubuntu/vaults/main
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=3000

# --- Cloudflare Access (not secrets: the team domain and AUD tag are public
# --- identifiers; the trust anchor is Cloudflare's rotating JWKS, fetched at
# --- runtime and never stored here).
Environment=CF_ACCESS_TEAM_DOMAIN=https://mkotik.cloudflareaccess.com
Environment=CF_ACCESS_AUD=c89ed5c74cbe54e3fadfa587a27cba6bb5bea00439a66c0f46199b9c041dd79d
Environment=MCP_PUBLIC_HOSTNAME=mcp.deangoldsteen.com

ExecStart=/usr/bin/node /home/ubuntu/obsidian-mcp/dist/server.js
Restart=on-failure
RestartSec=5

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/vaults/main
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
